# SKatalyst AI marketing website — environment example (local development)
# Copy to .env.development (or .env.local) and adjust as needed.

# API base URL the public site talks to (beta signup form, version footer).
# LOCAL DEV: the backend from skatalyst-ingest/packages/ingest, started with
#   `npm run dev` — it listens on http://localhost:3001.
# The beta signup form posts to ${REACT_APP_API_URL}/api/beta-signup.
REACT_APP_API_URL=http://localhost:3001

# Private-beta gate: keep public login ENABLED locally so the normal OAuth
# flow can be tested. Set to "false" to preview the production
# "Coming Soon" behavior locally.
REACT_APP_PUBLIC_LOGIN_ENABLED=true
