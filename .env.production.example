# SKatalyst AI marketing website — environment example (production build)
# Copy to .env.production. Used by `npm run build` (and deploy.sh).

# API base URL baked into the production bundle.
#
# TARGET (once the API domain is cut over — see docs/DOMAIN_CUTOVER_PLAN.md):
#   REACT_APP_API_URL=https://api.skatalystai.com
#
# CURRENT FALLBACK (documented, intentional): the API domain is NOT cut over
# yet, so production still points at the raw Cloud Run URL below. Replace it
# with https://api.skatalystai.com when the mapping is live.
#
# IMPORTANT: whichever URL is used, the backend service MUST allow the site's
# origins in CORS (FRONTEND_URL / CORS_ORIGINS env on the backend):
#   https://skatalystai.com AND https://www.skatalystai.com
# (the apex redirects to www, so both are required). Otherwise the beta
# signup form fails in the browser. See docs/BETA_SIGNUP_FORM_DEBUG.md.
REACT_APP_API_URL=https://skatalyst-ingest-235890259878.europe-west1.run.app

# Private-beta gate: public login stays DISABLED on the live site.
REACT_APP_PUBLIC_LOGIN_ENABLED=false
