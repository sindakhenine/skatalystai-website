# SKatalyst Frontend - Production Environment
# This file is used when running `npm run build`

# Production Backend URL (Cloud Run)
REACT_APP_API_URL=https://skatalyst-ingest-235890259878.europe-west1.run.app

# Private-beta gate: public login is DISABLED on the live site (skatalystai.com).
# Visitors who click Login / Sign in / Get Started / Start organizing free see
# the "Private Beta / Coming Soon" screen instead of the OAuth provider.
#
# >>> TO OPEN THE PUBLIC BETA LATER: change this to "true" and redeploy
#     (npm run deploy). <<<
REACT_APP_PUBLIC_LOGIN_ENABLED=false
